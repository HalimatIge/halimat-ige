
---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Experience — Halimat Ige"
  description="Professional experience and development work by Halimat Ige."
>
  <Header />

  <main class="container">
    <section class="page-section intro">
      <p class="eyebrow">EXPERIENCE / BACKGROUND</p>
      <h1 class="page-title">
        Where I've worked
        <span> and what I've built.</span>
      </h1>
      <p class="lead">
        My experience spans frontend development, internal
        business applications, API integration, and application support.
      </p>
    </section>

    <section class="page-section">
      <p class="eyebrow">PROFESSIONAL EXPERIENCE</p>

      <div class="rule-list">
        <article class="rule-item">
       
          <div>
            <h2 class="item-title">Frontend Developer · PN Africa</h2>
            <p class="muted">June 2026 — Present</p>
            <p class="item-description">
              Develop responsive web interfaces for a mentorship
              and career-development platform. Contribute to
              dashboard components, public pages, applicant
              payment interfaces, and API integration.
            </p>
            <p class="muted">
              Next.js · React · TypeScript · Tailwind CSS · Git
            </p>
           
          </div>
        </article>

        <article class="rule-item">
          
          <div>
            <h2 class="item-title">
              Application Support / Developer · Noor Takaful
            </h2>
            <p class="muted">September 2024 — September 2025</p>
            <p class="item-description">
              Support enterprise ERP and mobile application users,
              troubleshoot issues, assist with testing and
              configuration, and contribute to internal web
              interfaces and insurance workflow modules.
            </p>
            <p class="muted">
              Next.js · TypeScript · shadcn/ui · REST APIs · Postman
            </p>
           
          </div>
        </article>

        <article class="rule-item">
        
          <div>
            <h2 class="item-title">Trainee Web Developer · SQI College of ICT</h2>
            <p class="muted">March 2022 — October 2022</p>
            <p class="item-description">
              Developed web development skills through practical
              training and project work.
            </p>
          </div>
        </article>

        <article class="rule-item">
        
          <div>
            <h2 class="item-title">
              Industrial Training Student · SQI College of ICT
            </h2>
            <p class="muted">January 2023 — May 2023</p>
            <p class="item-description">
              Gained additional practical experience in web
              development during industrial training.
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="page-section">
      <p class="eyebrow">EDUCATION</p>
      <h2 class="item-title">
        Bachelor of Technology, Computer Science
      </h2>
      <p class="item-description">
        Ladoke Akintola University of Technology (LAUTECH),
        Ogbomoso · 2019–2024
      </p>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .intro {
    padding-top: 110px;
  }
</style>
