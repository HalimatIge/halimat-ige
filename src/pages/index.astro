
---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const projects = [
  {
    name: "PN Africa",
    description:
     "A cohort-based experience-development platform where applicants apply for admission, undergo administrative review. Aspiring mentors can also apply, have their CVs reviewed, and get matched with a cohort.",
    href: "/projects/pn-africa",
    liveUrl: "https://pnafrica.com/",
    tags: ["Next.js", "TypeScript", "Tailwind CSS", "shadcn/ui", "REST APIs"],
  },
 
  {
    name: "QuickPlate",
    description:
      "A food delivery application with menu browsing, a persistent shopping cart, user authentication, and an administration dashboard.",
    href: "/projects/quickplate",
    liveUrl: "https://food-delivery-frontend-beta-six.vercel.app/",
    githubUrl: null, // Add the specific repository URL when available
    tags: ["React", "Node.js", "Express.js", "MongoDB", "Cloudinary"],
  },
  {
    name: "Provera AI",
    description:
      "An AI-assisted transaction fraud detection platform that helps organizations identify suspicious activity, assess transaction risk, and review flagged transactions.",
    href: "https://provera-ai.vercel.app/",
    liveUrl: "https://provera-ai.vercel.app/",
    tags: ["React", "Web Development", "AI"],
  },
 
];
---

<Layout
  title="Halimat Ige — Frontend Developer"
  description="The portfolio of Halimat Ige, a frontend developer building thoughtful, responsive web experiences."
>
  <Header />

  <main class="container">
    <section class="intro">
      <h1>Hi, I'm Halimat.</h1>

      <p>
        I'm a frontend developer who enjoys turning ideas into thoughtful,
        accessible web experiences. I build responsive interfaces with React,
        Next.js, and TypeScript, and I care about making the web feel simple
        and intuitive.
      </p>

      <p class="intro-links">
        Currently building at
        <a class="text-link" href="https://provera-ai.vercel.app/"> Provera Ai.</a>
      
      </p>
    </section>

    <section class="selected-work" aria-labelledby="work-heading">
      <div class="section-heading">
        <h2 id="work-heading" class="eyebrow">A Few Things I’ve Built</h2>
        <a class="all-projects" href="/projects">
          All projects <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="project-list">
        {projects.map((project) => (
          <article class="project">
            <h3>
              <a href={project.href}>{project.name}</a>
            </h3>

            <p>{project.description}</p>

            <div class="project-meta">
              {project.tags.map((tag) => <span>{tag}</span>)}
            </div>

            <a class="project-link" href={project.href}>
              View project <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="more-about">
      <p>
        I'm always learning, building, and looking for opportunities to solve
        meaningful problems through software.
      </p>

      <div class="more-links">
        <a class="text-link" href="/about">More about me →</a>
        <a class="text-link" href="/experience">My experience →</a>
        <a class="text-link" href="/contact">Get in touch →</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .intro {
    padding-block: 104px 34px;
  }

  .intro h1 {
    margin: 0;
    font-size: 1.55rem;
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1.4;
  }

  .intro > p {
    max-width: 570px;
    margin: 17px 0 0;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .intro > .intro-links {
    margin-top: 12px;
    font-size: 0.94rem;
  }

  .selected-work {
    padding-top: 34px;
    border-top: 1px solid var(--border);
  }

  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 7px;
  }

  .section-heading h2 {
    margin: 0;
  }

  .all-projects {
    color: var(--muted);
    font-size: 0.88rem;
    white-space: nowrap;
    transition: color 160ms ease;
  }

  .all-projects:hover {
    color: var(--accent);
  }

  .project-list {
    border-bottom: 1px solid var(--border);
  }

  .project {
    padding-block: 24px;
    border-bottom: 1px solid var(--border);
  }

  .project:last-child {
    border-bottom: 0;
  }

  .project h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  .project h3 a {
    transition: color 160ms ease;
  }

  .project h3 a:hover {
    color: var(--accent);
  }

  .project > p {
    margin: 8px 0 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 14px;
    margin-top: 11px;
  }

  .project-meta span {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .project-link {
    display: inline-block;
    margin-top: 9px;
    color: var(--accent);
    font-size: 0.85rem;
  }

  .project-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .more-about {
    padding-block: 35px 18px;
  }

  .more-about > p {
    max-width: 550px;
    margin: 0;
    color: var(--muted);
  }

  .more-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 22px;
    margin-top: 17px;
    font-size: 0.9rem;
  }

  @media (max-width: 600px) {
    .intro {
      padding-top: 68px;
    }

    .intro h1 {
      font-size: 1.4rem;
    }

    .intro > p {
      font-size: 1rem;
    }

    .project {
      padding-block: 21px;
    }
  }
</style>
