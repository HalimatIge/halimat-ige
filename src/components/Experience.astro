
---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const experiences = [
  {
    company: "PN Africa",
    role: "Frontend Developer",
    period: "Jun 2026 — Present",
    location: "Remote",
    type: "Professional experience",
    description:
      "Building responsive interfaces for a mentorship and career-development platform, collaborating with designers and backend developers to deliver user-facing features.",
    achievements: [
      "Developed reusable interface components and dashboard features using Next.js, React, TypeScript, and Tailwind CSS.",
      "Built FAQ and applicant payment interfaces and contributed to public-facing pages.",
      "Worked with REST APIs and Git-based collaboration workflows.",
    ],
    technologies: ["Next.js", "React", "TypeScript", "Tailwind CSS", "shadcn/ui"],
  },
  {
    company: "Noor Takaful Insurance Plc",
    role: "Application Support / Developer",
    period: "September 2024 — September 2025",
    location: "Lagos, Nigeria",
    type: "Physical",
    description:
      "Supporting enterprise applications and helping improve internal workflows across business departments.",
    achievements: [
      "Developed frontend interfaces for an internal intranet portal and an agency module.",
      "Investigated and fixed issues in Reinsurance Treaty and Fund Transfer modules.",
      "Troubleshot ERP and mobile application issues, supported user acceptance testing, and documented solutions.",
      "Worked with users and development teams to resolve application issues and improve usability.",
    ],
    technologies: ["Next.js", "TypeScript", "shadcn/ui", "REST APIs", "Postman"],
  },
  {
    company: "SQI College of ICT",
    role: "Industrial Training Student",
    period: "Jan 2023 — May 2023",
    location: "Ogbomoso, Nigeria",
    type: "Industrial training",
    description:
      "Gained practical exposure to web development and software development workflows during industrial training.",
    achievements: [
      "Applied web development knowledge to practical learning tasks and projects.",
      "Strengthened foundational programming and frontend development skills.",
    ],
    technologies: ["Web Development", "JavaScript"],
  },
  {
    company: "SQI College of ICT",
    role: "Trainee Web Developer",
    period: "Mar 2022 — Oct 2022",
    location: "Ibadan, Nigeria",
    type: "Training",
    description:
      "Built foundational skills in web development through structured training and practical exercises.",
    achievements: [
      "Practised building web interfaces with HTML, CSS, and JavaScript.",
      "Developed an understanding of responsive design and frontend fundamentals.",
    ],
    technologies: ["HTML", "CSS", "JavaScript"],
  },
];

const education = [
  {
    institution: "Ladoke Akintola University of Technology",
    qualification: "Bachelor of Technology (B.Tech), Computer Science",
    period: "2018 — 2024",
    details: "Ogbomoso, Nigeria",
  },
];
---

<Layout
  title="Experience — Halimat Ige"
  description="Professional experience, technical contributions, and education of Halimat Ige, a frontend developer."
>
  <Header />

  <main class="container page-section">
    <header class="page-heading">
      <p class="eyebrow">Career journey</p>
      <h1 class="page-title">Experience</h1>
      <p class="lead">
        My work, learning, and contributions across web development and
        application support.
      </p>
    </header>

    <section class="timeline-section" aria-labelledby="work-heading">
      <h2 id="work-heading" class="section-label">Work experience</h2>

      <div class="timeline">
        {experiences.map((experience) => (
          <article class="timeline-entry">
            <div class="timeline-marker" aria-hidden="true"></div>

            <div class="entry-header">
              <div class="entry-main">
                <p class="entry-period">{experience.period}</p>
                <h3>{experience.role}</h3>
                <p class="entry-company">{experience.company}</p>
              </div>

              <span class="entry-type">{experience.type}</span>
            </div>

            <p class="entry-description">{experience.description}</p>

            <ul class="achievement-list">
              {experience.achievements.map((achievement) => (
                <li>{achievement}</li>
              ))}
            </ul>

            <div class="technology-list" aria-label="Technologies and skills">
              {experience.technologies.map((technology) => (
                <span>{technology}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="education-section" aria-labelledby="education-heading">
      <h2 id="education-heading" class="section-label">Education</h2>

      <div class="education-list">
        {education.map((item) => (
          <article class="education-entry">
            <p class="entry-period">{item.period}</p>
            <h3>{item.qualification}</h3>
            <p class="entry-company">{item.institution}</p>
            <p class="education-details">{item.details}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="resume-cta">
      <p>
        Want to know more about my background or discuss an opportunity?
      </p>
      <a class="text-link" href="/contact">Get in touch →</a>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-heading {
    margin-bottom: 45px;
  }

  .page-heading .eyebrow {
    margin: 0 0 8px;
  }

  .timeline-section,
  .education-section {
    margin-top: 38px;
  }

  .section-label {
    margin: 0 0 23px;
    font-size: 0.85rem;
    font-weight: 650;
    letter-spacing: 0.035em;
  }

  .timeline {
    position: relative;
    margin-left: 5px;
    padding-left: 25px;
    border-left: 1px solid var(--border);
  }

  .timeline-entry {
    position: relative;
    padding-bottom: 37px;
  }

  .timeline-entry:last-child {
    padding-bottom: 4px;
  }

  .timeline-marker {
    position: absolute;
    top: 5px;
    left: -30px;
    width: 9px;
    height: 9px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--background);
  }

  .entry-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .entry-period {
    margin: 0 0 5px;
    color: var(--muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  .entry-main h3,
  .education-entry h3 {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.5;
  }

  .entry-company {
    margin: 3px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .entry-type {
    flex-shrink: 0;
    padding: 3px 9px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.6;
  }

  .entry-description {
    margin: 15px 0 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .achievement-list {
    display: grid;
    gap: 8px;
    margin: 14px 0 0;
    padding-left: 19px;
  }

  .achievement-list li {
    padding-left: 3px;
    line-height: 1.7;
  }

  .achievement-list li::marker {
    color: var(--accent);
  }

  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 13px;
    margin-top: 15px;
  }

  .technology-list span {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .education-section {
    padding-top: 31px;
    border-top: 1px solid var(--border);
  }

  .education-list {
    border-bottom: 1px solid var(--border);
  }

  .education-entry {
    padding-block: 21px;
    border-top: 1px solid var(--border);
  }

  .education-details {
    margin: 7px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .resume-cta {
    margin-top: 38px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .resume-cta p {
    margin: 0 0 9px;
    color: var(--muted);
  }

  .resume-cta a {
    font-size: 0.92rem;
  }

  @media (max-width: 520px) {
    .page-heading {
      margin-bottom: 35px;
    }

    .entry-header {
      flex-direction: column;
      gap: 7px;
    }

    .entry-type {
      align-self: flex-start;
    }

    .timeline {
      padding-left: 20px;
    }

    .timeline-marker {
      left: -25px;
    }
  }
</style>
