
---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Projects", href: "/projects" },
  { label: "Experience", href: "/experience" },
  
  { label: "Contact", href: "/contact" },
];
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="Halimat Ige home">
      hi<span>.</span>
    </a>

    <nav class="main-nav" aria-label="Main navigation">
      {navItems.map((item) => {
        const active =
          item.href === "/"
            ? currentPath === "/"
            : currentPath === item.href ||
              currentPath.startsWith(`${item.href}/`);

        return (
          <a
            href={item.href}
            class:list={["nav-link", { active }]}
            aria-current={active ? "page" : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <button
      class="theme-toggle"
      id="theme-toggle"
      type="button"
      aria-label="Switch to dark mode"
      title="Toggle colour theme"
    >
      <svg
        id="theme-icon"
        width="19"
        height="19"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z" />
      </svg>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background: var(--background);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    width: min(720px, calc(100% - 40px));
    min-height: 64px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    flex-shrink: 0;
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 750;
    letter-spacing: -0.06em;
  }

  .brand span {
    color: var(--accent);
  }

  .main-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 23px;
  }

  .nav-link {
    position: relative;
    color: var(--muted);
    font-size: 0.9rem;
    transition: color 160ms ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
  }

  .nav-link.active {
    font-weight: 550;
  }

  .theme-toggle {
    display: grid;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .theme-toggle:hover {
    background: var(--surface);
    color: var(--text);
  }

  @media (max-width: 650px) {
    .header-inner {
      width: calc(100% - 32px);
      min-height: 60px;
      gap: 12px;
    }

    .main-nav {
      gap: 14px;
    }

    .nav-link {
      font-size: 0.82rem;
    }
  }

  @media (max-width: 460px) {
    .header-inner {
      flex-wrap: wrap;
      padding-block: 12px;
    }

    .main-nav {
      order: 3;
      width: 100%;
      justify-content: space-between;
      gap: 8px;
    }

    .nav-link {
      font-size: 0.8rem;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("#theme-toggle");
  const icon = document.querySelector<SVGElement>("#theme-icon");

  function updateTheme(theme: "light" | "dark") {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem("portfolio-theme", theme);

    const isDark = theme === "dark";

    toggle?.setAttribute(
      "aria-label",
      isDark ? "Switch to light mode" : "Switch to dark mode",
    );

    if (icon) {
      icon.innerHTML = isDark
        ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path>'
        : '<path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"></path>';
    }

    document
      .querySelector<HTMLMetaElement>('meta[name="theme-color"]')
      ?.setAttribute("content", isDark ? "#171715" : "#faf9f6");
  }

  const savedTheme = localStorage.getItem("portfolio-theme");

  updateTheme(savedTheme === "dark" ? "dark" : "light");

  toggle?.addEventListener("click", () => {
    const currentTheme =
      document.documentElement.dataset.theme === "dark" ? "dark" : "light";

    updateTheme(currentTheme === "dark" ? "light" : "dark");
  });
</script>
